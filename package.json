        "@types/cors": "^2.8.17",
        "@types/exceljs": "^1.3.2",
        "@types/express-fileupload": "^1.5.1",
        "@types/express-validator": "^3.0.2",
        "@types/html-to-text": "^9.0.4",
        "@types/nodemailer": "^6.4.16",
        "async-file": "^2.0.2",
        "axios": "^1.13.4",
        "bcrypt": "^5.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-fileupload": "^1.5.1",
