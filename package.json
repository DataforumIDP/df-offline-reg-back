        "express-validator": "^7.2.0",
        "html-to-text": "^9.0.5",
        "isolated-vm": "^6.1.2",
        "jsonwebtoken": "^9.0.0",
        "knex": "^3.1.0",
        "libphonenumber-js": "^1.12.39",
